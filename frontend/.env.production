# ============================================================
# PRODUCTION ENVIRONMENT — Hostinger Deployment
# ============================================================
# Vite membaca .env.production saat `vite build --mode production`

VITE_FORCE_API_IN_DEV=false
VITE_DATA_SOURCE=api

# API base URL — backend di subdomain api.mahreenindonesia.com
# Semua request /api/* akan dikirim ke subdomain ini.
VITE_API_BASE_URL=https://api.mahreenindonesia.com/api

VITE_SITE_URL=https://frontend.mahreenindonesia.com
VITE_API_TIMEOUT_MS=15000
VITE_API_USE_CREDENTIALS=true

VITE_ENABLE_TRANSACTION_UI=true
VITE_ENABLE_DOCUMENT_VERIFICATION=true
VITE_ENABLE_DYNAMIC_CONTENT_INDEXING=false
VITE_ENABLE_ADMIN_UI=true
VITE_ENABLE_CLIENT_SECURITY_CENTER=true
VITE_ENABLE_CLIENT_DOCUMENTS=true
VITE_ENABLE_INTERN_DASHBOARD=true
