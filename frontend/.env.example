# Konfigurasi production normal.
VITE_FORCE_API_IN_DEV=true

VITE_API_BASE_URL=/api
VITE_SITE_URL=https://mahreenindonesia.com
VITE_API_TIMEOUT_MS=15000
VITE_API_USE_CREDENTIALS=true

# Aktifkan hanya setelah payment gateway, webhook, dan endpoint status transaksi siap.
VITE_ENABLE_TRANSACTION_UI=false

# Aktifkan hanya setelah endpoint verifikasi dokumen resmi siap.
VITE_ENABLE_DOCUMENT_VERIFICATION=false

# false selama halaman detail artikel/produk/event/portfolio masih dummy atau local.
# Ubah ke true hanya setelah backend/CMS dan sitemap dinamis sudah siap.
VITE_ENABLE_DYNAMIC_CONTENT_INDEXING=false
