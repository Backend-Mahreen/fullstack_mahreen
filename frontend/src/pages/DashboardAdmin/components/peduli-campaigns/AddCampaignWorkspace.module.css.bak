.acw {
    --acw-gold: #e7c77c;
    --acw-gold-bright: #f0d18a;
    --acw-panel: #101110;
    --acw-panel-raised: #141514;
    --acw-border: rgba(255,255,255,.085);
    --acw-gold-border: rgba(231,199,124,.26);
    position: relative;
    width: 100%;
    min-height: calc(100vh - 92px);
    padding: 2px 0 58px;
    color: #eeeae3;
  }
  .acw::before {
    position: fixed;
    z-index: -1;
    top: 110px;
    right: 3%;
    width: 420px;
    height: 420px;
    border-radius: 50%;
    content: "";
    background: rgba(231,199,124,.045);
    filter: blur(96px);
    pointer-events: none;
  }
  .acw-reveal {
    opacity: 0;
    transform: translate3d(0,20px,0) scale(.992);
    animation: acw-reveal 660ms var(--acw-delay,0ms) cubic-bezier(.22,1,.36,1) both;
  }
  .acw-breadcrumb {
    display: flex;
    margin: 0 0 16px;
    align-items: center;
    gap: 7px;
    color: #817c72;
    font: 700 9px/1.2 ui-monospace,SFMono-Regular,Menlo,monospace;
  }
  .acw-breadcrumb b { color: var(--acw-gold); font-weight: 700; }
  .acw-header {
    display: flex;
    min-height: 96px;
    margin-bottom: 30px;
    align-items: flex-start;
    justify-content: space-between;
    gap: 30px;
  }
  .acw-header__title { display: flex; align-items: flex-start; gap: 15px; }
  .acw-header__back {
    display: grid;
    width: 41px;
    height: 41px;
    margin-top: 2px;
    flex: 0 0 auto;
    place-items: center;
    border: 1px solid rgba(255,255,255,.11);
    border-radius: 7px;
    color: #b5afa5;
    background: #0d0e0d;
    cursor: pointer;
    transition: color 200ms ease,border-color 200ms ease,transform 220ms cubic-bezier(.22,1,.36,1),box-shadow 200ms ease;
  }
  .acw-header__back:hover { color: var(--acw-gold);border-color:var(--acw-gold-border);transform:translateX(-3px);box-shadow:0 0 22px rgba(231,199,124,.07); }
  .acw-header__back svg { width: 18px; }
  .acw-header h1 {
    margin: 0;
    color: #f2eee8;
    font-size: clamp(32px,3.2vw,47px);
    font-weight: 620;
    line-height: 1.04;
    letter-spacing: -.045em;
  }
  .acw-header p { max-width: 660px;margin:10px 0 0;color:#918b82;font-size:12px;line-height:1.55; }
  .acw-header__actions { display:flex;align-items:center;gap:12px; }
  .acw-header__actions button {
    position: relative;
    display: inline-flex;
    min-width: 114px;
    min-height: 50px;
    padding: 10px 18px;
    align-items: center;
    justify-content: center;
    gap: 9px;
    overflow: hidden;
    border: 1px solid rgba(255,255,255,.11);
    border-radius: 5px;
    color: #d0cac0;
    background: #101110;
    cursor: pointer;
    font: 750 9px/1.2 ui-monospace,SFMono-Regular,Menlo,monospace;
    letter-spacing: .055em;
    transition: transform 220ms cubic-bezier(.22,1,.36,1),border-color 220ms ease,box-shadow 220ms ease,filter 220ms ease;
  }
  .acw-header__actions button svg { width:15px;height:15px; }
  .acw-header__actions button:hover { transform:translateY(-3px);border-color:var(--acw-gold-border);box-shadow:0 14px 30px rgba(0,0,0,.24),0 0 24px rgba(231,199,124,.06); }
  .acw-header__actions .is-publish { min-width:168px;color:#1d1709;border-color:#e8c775;background:linear-gradient(135deg,#f1d38e,#dfba66);box-shadow:0 13px 28px rgba(231,199,124,.14); }
  .acw-header__actions .is-publish::after,.acw-publish-button::after {
    position:absolute;top:-70%;left:-35%;width:24%;height:240%;content:"";background:linear-gradient(90deg,transparent,rgba(255,255,255,.38),transparent);transform:rotate(17deg);transition:left 560ms ease;
  }
  .acw-header__actions .is-publish:hover::after,.acw-publish-button:hover::after { left:118%; }
  .acw-layout { display:grid;grid-template-columns:minmax(0,1fr) minmax(320px,365px);gap:30px;align-items:start; }
  .acw-main-column { display:grid;gap:25px; }
  .acw-side-column { position:sticky;top:22px;display:grid;gap:24px; }
  .acw-card {
    position: relative;
    padding: 29px 28px;
    border: 1px solid var(--acw-border);
    border-radius: 10px;
    background: radial-gradient(circle at 100% 0,rgba(231,199,124,.025),transparent 38%),linear-gradient(145deg,rgba(255,255,255,.013),transparent 62%),var(--acw-panel);
    box-shadow: 0 22px 58px rgba(0,0,0,.17);
    transition: transform 260ms cubic-bezier(.22,1,.36,1),border-color 260ms ease,box-shadow 260ms ease;
  }
  .acw-card:hover { border-color:rgba(231,199,124,.21);box-shadow:0 26px 64px rgba(0,0,0,.25),0 0 30px rgba(231,199,124,.035);transform:translateY(-3px); }
  .acw-card__heading { display:flex;margin-bottom:27px;align-items:center;gap:12px; }
  .acw-card__heading > span { display:grid;width:36px;height:36px;place-items:center;border-radius:7px;color:var(--acw-gold);background:rgba(231,199,124,.1);box-shadow:inset 0 0 0 1px rgba(231,199,124,.07),0 0 18px rgba(231,199,124,.035); }
  .acw-card__heading svg { width:17px;height:17px; }
  .acw-card__heading h2 { margin:0;color:#eeeae4;font-size:18px;font-weight:570;letter-spacing:-.02em; }
  .acw-field { position:relative;display:grid;gap:9px; }
  .acw-field > span,.acw-media__label { color:#a9a39a;font:650 8px/1.3 ui-monospace,SFMono-Regular,Menlo,monospace;letter-spacing:.035em; }
  .acw-field input,.acw-field select,.acw-field textarea {
    width:100%;min-height:47px;padding:11px 14px;border:1px solid rgba(255,255,255,.085);border-radius:6px;outline:0;color:#e2ded7;background:#0b0c0b;font-size:10px;transition:border-color 180ms ease,box-shadow 180ms ease,background 180ms ease;
  }
  .acw-field select { color-scheme:dark; }
  .acw-field textarea { min-height:118px;resize:vertical;line-height:1.6; }
  .acw-field textarea.is-small { min-height:84px; }
  .acw-field input:focus,.acw-field select:focus,.acw-field textarea:focus { border-color:rgba(231,199,124,.43);background:#0e0f0e;box-shadow:0 0 0 3px rgba(231,199,124,.045),0 0 20px rgba(231,199,124,.035); }
  .acw-field input::placeholder,.acw-field textarea::placeholder { color:#5d5b61; }
  .acw-field > small { position:absolute;right:9px;bottom:7px;color:#625f59;font:600 7px ui-monospace,SFMono-Regular,Menlo,monospace; }
  .acw-field--spaced { margin-top:24px; }
  .acw-two-fields { display:grid;margin-top:23px;grid-template-columns:1fr 1fr;gap:22px; }
  .acw-two-fields--wide-right { grid-template-columns:.82fr 1.18fr; }
  .acw-three-fields { display:grid;grid-template-columns:1fr 1fr 1.08fr;gap:20px; }
  .acw-money-input { position:relative; }
  .acw-money-input b { position:absolute;z-index:1;top:50%;left:14px;color:var(--acw-gold);font:700 10px ui-monospace,SFMono-Regular,Menlo,monospace;transform:translateY(-50%); }
  .acw-money-input input { padding-left:39px; }
  .acw-editor { overflow:hidden;border:1px solid rgba(255,255,255,.085);border-radius:6px;background:#0b0c0b; }
  .acw-editor:focus-within { border-color:rgba(231,199,124,.43);box-shadow:0 0 0 3px rgba(231,199,124,.045),0 0 20px rgba(231,199,124,.035); }
  .acw-editor__toolbar { display:flex;min-height:40px;padding:0 10px;align-items:center;gap:3px;border-bottom:1px solid rgba(255,255,255,.07);background:#1b1c1b; }
  .acw-editor__toolbar button { display:grid;width:30px;height:30px;place-items:center;border:0;border-radius:4px;color:#b5afa6;background:transparent;cursor:pointer; }
  .acw-editor__toolbar button:hover { color:var(--acw-gold);background:rgba(231,199,124,.07); }
  .acw-editor__toolbar svg { width:13px;height:13px; }
  .acw-editor textarea { min-height:190px;border:0;border-radius:0;box-shadow:none!important;background:transparent!important; }
  .acw-media__label { display:block;margin:0 0 10px; }
  .acw-media__label--gallery { margin-top:24px; }
  .acw-thumbnail { position:relative;display:grid;width:100%;min-height:220px;padding:20px;place-items:center;align-content:center;gap:8px;overflow:hidden;border:1px dashed rgba(231,199,124,.3);border-radius:7px;color:#9b968d;background:#0b0c0b;cursor:pointer;transition:border-color 220ms ease,box-shadow 220ms ease,transform 220ms cubic-bezier(.22,1,.36,1); }
  .acw-thumbnail:hover { border-color:rgba(231,199,124,.68);box-shadow:0 0 26px rgba(231,199,124,.06);transform:translateY(-2px); }
  .acw-thumbnail > svg { width:28px;height:28px;color:var(--acw-gold); }
  .acw-thumbnail strong { font-size:10px;font-weight:560; }
  .acw-thumbnail small { color:#68645e;font-size:8px; }
  .acw-thumbnail.has-image { padding:0;border-style:solid; }
  .acw-thumbnail img { width:100%;height:220px;object-fit:cover;transition:transform 500ms cubic-bezier(.22,1,.36,1); }
  .acw-thumbnail:hover img { transform:scale(1.035); }
  .acw-gallery { display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:11px; }
  .acw-gallery__add,.acw-gallery__empty,.acw-gallery__item { position:relative;display:grid;min-height:105px;place-items:center;overflow:hidden;border:1px solid rgba(255,255,255,.07);border-radius:6px;background:#181918; }
  .acw-gallery__add { align-content:center;gap:4px;border-style:dashed;border-color:rgba(231,199,124,.26);color:var(--acw-gold);background:#0b0c0b;cursor:pointer; }
  .acw-gallery__add svg { width:18px; }
  .acw-gallery__add span,.acw-gallery__empty { color:#625f59;font:600 7px ui-monospace,SFMono-Regular,Menlo,monospace;text-transform:uppercase; }
  .acw-gallery__item img { width:100%;height:105px;object-fit:cover; }
  .acw-gallery__item button { position:absolute;top:6px;right:6px;display:grid;width:26px;height:26px;place-items:center;border:1px solid rgba(255,255,255,.12);border-radius:50%;color:#f0d8d4;background:rgba(10,10,10,.82);cursor:pointer;opacity:0;transform:translateY(-4px);transition:opacity 180ms ease,transform 180ms ease; }
  .acw-gallery__item:hover button { opacity:1;transform:none; }
  .acw-gallery__item svg { width:12px;height:12px; }
  .acw-publishing header { display:flex;margin-bottom:26px;align-items:center;justify-content:space-between;gap:15px; }
  .acw-publishing h2 { margin:0;color:#ece8e1;font-size:16px;font-weight:570; }
  .acw-publishing header > span { padding:5px 10px;border-radius:99px;color:#8c877d;background:#202120;font:700 7px ui-monospace,SFMono-Regular,Menlo,monospace;text-transform:uppercase; }
  .acw-publish-row { display:flex;min-height:62px;align-items:center;justify-content:space-between;gap:14px;border-bottom:1px solid rgba(255,255,255,.06); }
  .acw-publish-row > span { display:flex;align-items:center;gap:10px;color:var(--acw-gold); }
  .acw-publish-row svg { width:16px;height:16px; }
  .acw-publish-row > span span { display:grid;gap:3px;color:#d2ccc3;font-size:10px; }
  .acw-publish-row small { color:#747068;font-size:8px; }
  .acw-publish-row select,.acw-publish-row input { max-width:145px;min-height:34px;padding:6px 7px;border:0;outline:0;color:var(--acw-gold);background:transparent;font-size:8px;color-scheme:dark; }
  .acw-check { display:flex;margin-top:16px;align-items:center;gap:9px;color:#a39e95;font-size:9px;cursor:pointer; }
  .acw-check input { width:16px;height:16px;accent-color:var(--acw-gold); }
  .acw-publish-button,.acw-draft-button,.acw-delete-button { position:relative;display:flex;width:100%;min-height:48px;margin-top:22px;align-items:center;justify-content:center;gap:8px;overflow:hidden;border:1px solid var(--acw-gold);border-radius:6px;color:#1b1608;background:linear-gradient(135deg,#f0d28b,#dfb965);cursor:pointer;font-size:10px;font-weight:740;box-shadow:0 12px 28px rgba(231,199,124,.13);transition:transform 220ms cubic-bezier(.22,1,.36,1),box-shadow 220ms ease,filter 220ms ease; }
  .acw-publish-button:hover,.acw-draft-button:hover { transform:translateY(-3px);box-shadow:0 16px 34px rgba(231,199,124,.22),0 0 26px rgba(231,199,124,.09);filter:brightness(1.05); }
  .acw-publish-button svg,.acw-draft-button svg,.acw-delete-button svg { width:14px;height:14px; }
  .acw-draft-button { margin-top:10px;color:#d9d3c9;border-color:rgba(255,255,255,.11);background:transparent;box-shadow:none; }
  .acw-delete-button { margin-top:10px;min-height:37px;color:#b8756d;border:0;background:transparent;box-shadow:none;font-size:8px; }
  .acw-optimization h2 { display:flex;margin:0;align-items:center;gap:8px;color:var(--acw-gold);font:700 10px ui-monospace,SFMono-Regular,Menlo,monospace;text-transform:uppercase; }
  .acw-optimization h2 svg { width:15px; }
  .acw-optimization p { margin:17px 0 18px;color:#8d887f;font-size:9px;line-height:1.65; }
  .acw-completion { height:5px;overflow:hidden;background:#272824; }
  .acw-completion i { display:block;height:100%;background:linear-gradient(90deg,#cba655,#f0d18a);box-shadow:0 0 12px rgba(231,199,124,.2);transition:width 450ms cubic-bezier(.22,1,.36,1); }
  .acw-optimization > small { display:block;margin-top:8px;color:#777269;font:600 7px ui-monospace,SFMono-Regular,Menlo,monospace;text-align:right; }
  .acw-preview-backdrop { position:fixed;z-index:300;inset:0;display:grid;padding:24px;place-items:center;background:rgba(0,0,0,.82);backdrop-filter:blur(10px);animation:acw-fade 220ms ease both; }
  .acw-preview { position:relative;width:min(760px,100%);overflow:hidden;border:1px solid var(--acw-gold-border);border-radius:13px;background:#121312;box-shadow:0 35px 100px rgba(0,0,0,.75),0 0 45px rgba(231,199,124,.08);animation:acw-preview 420ms cubic-bezier(.22,1,.36,1) both; }
  .acw-preview__close { position:absolute;z-index:2;top:14px;right:14px;display:grid;width:38px;height:38px;place-items:center;border:1px solid rgba(255,255,255,.15);border-radius:50%;color:#eee;background:rgba(0,0,0,.6);cursor:pointer; }
  .acw-preview__close svg { width:17px; }
  .acw-preview__image { height:310px;background:linear-gradient(135deg,#25261f,#0b0c0b); }
  .acw-preview__image img { width:100%;height:100%;object-fit:cover; }
  .acw-preview__body { padding:30px; }
  .acw-preview__body small { color:var(--acw-gold);font:700 8px ui-monospace,SFMono-Regular,Menlo,monospace;text-transform:uppercase; }
  .acw-preview__body h2 { margin:8px 0 10px;color:#f0ede7;font-size:30px;letter-spacing:-.035em; }
  .acw-preview__body p { margin:0;color:#9a958c;font-size:12px;line-height:1.7; }
  @keyframes acw-reveal { from { opacity:0;transform:translate3d(0,20px,0) scale(.992); } to { opacity:1;transform:none; } }
  @keyframes acw-fade { from { opacity:0; } to { opacity:1; } }
  @keyframes acw-preview { from { opacity:0;transform:translateY(20px) scale(.97); } to { opacity:1;transform:none; } }
  @media (max-width:1180px) { .acw-layout{grid-template-columns:minmax(0,1fr) 310px;gap:20px}.acw-three-fields{grid-template-columns:1fr 1fr}.acw-three-fields .acw-field:last-child{grid-column:1/-1}.acw-gallery{grid-template-columns:repeat(3,1fr)} }
  @media (max-width:920px) { .acw-header{flex-direction:column}.acw-header__actions{width:100%;flex-wrap:wrap}.acw-header__actions button{flex:1}.acw-layout{grid-template-columns:1fr}.acw-side-column{position:static;grid-template-columns:1fr 1fr}.acw-publishing{grid-row:1/3}.acw-optimization{align-self:start} }
  @media (max-width:680px) { .acw-header__actions{display:grid;grid-template-columns:1fr 1fr}.acw-header__actions .is-publish{grid-column:1/-1}.acw-two-fields,.acw-two-fields--wide-right,.acw-three-fields{grid-template-columns:1fr}.acw-three-fields .acw-field:last-child{grid-column:auto}.acw-side-column{grid-template-columns:1fr}.acw-publishing{grid-row:auto}.acw-gallery{grid-template-columns:repeat(2,1fr)}.acw-card{padding:23px 18px}.acw-preview__image{height:220px} }
  @media (prefers-reduced-motion:reduce) { .acw-reveal,.acw-preview-backdrop,.acw-preview{opacity:1;transform:none;animation:none}.acw *,.acw *::before,.acw *::after{transition-duration:.01ms!important} }
