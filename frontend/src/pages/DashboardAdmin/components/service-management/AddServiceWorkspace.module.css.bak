.ans-admin {
    --ans-gold: #edc64f;
    --ans-gold-pale: #e8c77e;
    --ans-panel: #111211;
    --ans-border: rgba(255,255,255,.09);
    --ans-gold-border: rgba(237,198,79,.25);
    position: relative;
    width: 100%;
    min-height: calc(100vh - 90px);
    padding: 6px 2px 50px;
    color: #efede8;
    font-family: Inter, ui-sans-serif, system-ui, sans-serif;
  }

  .ans-admin::before {
    position: absolute;
    z-index: -1;
    top: 40px;
    right: 2%;
    width: 330px;
    height: 330px;
    border-radius: 50%;
    content: "";
    background: rgba(237,198,79,.04);
    filter: blur(80px);
    pointer-events: none;
  }

  .ans-reveal {
    opacity: 0;
    transform: translate3d(0,18px,0) scale(.994);
    animation: ans-reveal 650ms var(--ans-delay,0ms) cubic-bezier(.22,1,.36,1) both;
  }

  .ans-header {
    display: flex;
    min-height: 112px;
    margin-bottom: 26px;
    align-items: flex-start;
    justify-content: space-between;
    gap: 30px;
  }

  .ans-header h1 {
    margin: 0;
    color: #f3f0ea;
    font-size: clamp(32px,3vw,46px);
    font-weight: 650;
    line-height: 1.04;
    letter-spacing: -.045em;
  }

  .ans-header p {
    max-width: 610px;
    margin: 10px 0 0;
    color: #a19b91;
    font-size: 12px;
    line-height: 1.55;
  }

  .ans-header__actions {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .ans-header__actions button {
    display: inline-flex;
    min-width: 103px;
    min-height: 48px;
    padding: 10px 18px;
    align-items: center;
    justify-content: center;
    gap: 8px;
    border: 1px solid rgba(255,255,255,.12);
    border-radius: 3px;
    color: #b6b0a7;
    background: transparent;
    cursor: pointer;
    font: 700 8px/1.25 ui-monospace,SFMono-Regular,Menlo,monospace;
    letter-spacing: .09em;
    transition: transform 220ms cubic-bezier(.22,1,.36,1), border-color 220ms ease, box-shadow 220ms ease, color 220ms ease, filter 220ms ease;
  }

  .ans-header__actions button svg { width: 14px; height: 14px; }
  .ans-header__actions button:hover {
    color: var(--ans-gold);
    border-color: rgba(237,198,79,.42);
    box-shadow: 0 0 22px rgba(237,198,79,.07);
    transform: translateY(-3px);
  }

  .ans-header__actions .is-draft {
    color: #eeeae3;
    background: rgba(255,255,255,.08);
  }

  .ans-header__actions .is-publish {
    position: relative;
    min-width: 132px;
    overflow: hidden;
    color: #1b1608;
    border-color: var(--ans-gold);
    background: linear-gradient(135deg,#f8d766,#e9bd3e);
    box-shadow: 0 12px 28px rgba(237,198,79,.13);
  }

  .ans-header__actions .is-publish::after,
  .ans-publishing__publish::after {
    position: absolute;
    top: -60%;
    left: -40%;
    width: 26%;
    height: 220%;
    content: "";
    background: linear-gradient(90deg,transparent,rgba(255,255,255,.34),transparent);
    transform: rotate(16deg);
    transition: left 540ms ease;
  }

  .ans-header__actions .is-publish:hover::after,
  .ans-publishing__publish:hover::after { left: 115%; }
  .ans-header__actions .is-publish:hover { color: #161205; filter: brightness(1.06); }

  .ans-layout {
    display: grid;
    grid-template-columns: minmax(0,1fr) minmax(300px,340px);
    gap: 24px;
    align-items: start;
  }

  .ans-main-column,
  .ans-side-column {
    display: grid;
    gap: 24px;
  }

  .ans-side-column {
    position: sticky;
    top: 20px;
  }

  .ans-card {
    position: relative;
    padding: 27px 25px;
    border: 1px solid var(--ans-border);
    border-radius: 10px;
    background: radial-gradient(circle at 100% 0,rgba(237,198,79,.025),transparent 38%),linear-gradient(145deg,rgba(255,255,255,.013),transparent 60%),var(--ans-panel);
    box-shadow: 0 20px 50px rgba(0,0,0,.16);
    transition: transform 260ms cubic-bezier(.22,1,.36,1), border-color 260ms ease, box-shadow 260ms ease;
  }

  .ans-card:hover {
    border-color: rgba(237,198,79,.22);
    box-shadow: 0 24px 60px rgba(0,0,0,.25),0 0 28px rgba(237,198,79,.035);
    transform: translateY(-3px);
  }

  .ans-card__heading {
    display: flex;
    margin-bottom: 25px;
    align-items: center;
    gap: 11px;
  }

  .ans-card__heading > span {
    display: grid;
    width: 35px;
    height: 35px;
    place-items: center;
    border-radius: 6px;
    color: var(--ans-gold);
    background: rgba(237,198,79,.1);
    box-shadow: inset 0 0 0 1px rgba(237,198,79,.08);
  }

  .ans-card__heading svg { width: 17px; height: 17px; }
  .ans-card__heading h2 {
    margin: 0;
    color: #eeeae4;
    font-size: 18px;
    font-weight: 560;
    line-height: 1.08;
    letter-spacing: -.02em;
  }

  .ans-field {
    position: relative;
    display: grid;
    gap: 9px;
  }

  .ans-field > span,
  .ans-status-field span,
  .ans-feature-heading > span,
  .ans-media__label {
    color: #aaa49b;
    font: 650 8px ui-monospace,SFMono-Regular,Menlo,monospace;
    letter-spacing: .035em;
  }

  .ans-field input,
  .ans-field select,
  .ans-field textarea,
  .ans-feature input {
    width: 100%;
    min-height: 45px;
    padding: 10px 13px;
    border: 1px solid rgba(255,255,255,.08);
    border-radius: 6px;
    outline: 0;
    color: #e3dfd8;
    background: #0c0d0c;
    font-size: 10px;
    transition: border-color 180ms ease,box-shadow 180ms ease,background 180ms ease;
  }

  .ans-field select { color-scheme: dark; }
  .ans-field textarea { min-height: 118px; resize: vertical; line-height: 1.55; }
  .ans-field textarea.is-small { min-height: 88px; }
  .ans-field input:focus,
  .ans-field select:focus,
  .ans-field textarea:focus,
  .ans-feature input:focus {
    border-color: rgba(237,198,79,.42);
    background: #0f100f;
    box-shadow: 0 0 0 3px rgba(237,198,79,.045),0 0 18px rgba(237,198,79,.035);
  }
  .ans-field input::placeholder,.ans-field textarea::placeholder,.ans-feature input::placeholder { color: #65626a; }
  .ans-field > small {
    position: absolute;
    right: 9px;
    bottom: 7px;
    color: #64615b;
    font: 600 7px ui-monospace,SFMono-Regular,Menlo,monospace;
  }

  .ans-two-fields {
    display: grid;
    margin-top: 24px;
    grid-template-columns: 1fr 1fr;
    gap: 22px;
  }

  .ans-status-field {
    display: flex;
    min-height: 67px;
    padding: 11px 14px;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    border: 1px solid rgba(255,255,255,.08);
    border-radius: 6px;
    background: #0c0d0c;
  }

  .ans-status-field > div { display: flex; flex-direction: column; gap: 5px; }
  .ans-status-field small { color: #6e6a63; font-size: 8px; }
  .ans-status-field button {
    position: relative;
    width: 39px;
    height: 22px;
    flex: 0 0 auto;
    border: 0;
    border-radius: 99px;
    background: #3b3c3b;
    cursor: pointer;
    transition: background 220ms ease,box-shadow 220ms ease;
  }
  .ans-status-field button i {
    position: absolute;
    top: 3px;
    left: 3px;
    width: 16px;
    height: 16px;
    border-radius: 50%;
    background: #eee;
    transition: transform 250ms cubic-bezier(.22,1,.36,1);
  }
  .ans-status-field button.is-active { background: var(--ans-gold); box-shadow: 0 0 17px rgba(237,198,79,.15); }
  .ans-status-field button.is-active i { transform: translateX(17px); }

  .ans-pricing .ans-field + .ans-field { margin-top: 24px; }
  .ans-price-input { position: relative; }
  .ans-price-input b {
    position: absolute;
    z-index: 1;
    top: 50%;
    left: 13px;
    color: var(--ans-gold);
    font: 700 10px ui-monospace,SFMono-Regular,Menlo,monospace;
    transform: translateY(-50%);
  }
  .ans-price-input input { padding-left: 35px; }

  .ans-feature-heading {
    display: flex;
    margin: 25px 0 10px;
    align-items: center;
    justify-content: space-between;
    gap: 15px;
  }
  .ans-feature-heading button {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    border: 0;
    color: var(--ans-gold);
    background: transparent;
    cursor: pointer;
    font: 700 7px ui-monospace,SFMono-Regular,Menlo,monospace;
  }
  .ans-feature-heading svg { width: 10px;height: 10px; }
  .ans-feature-list { display: grid; gap: 10px; }
  .ans-feature { display: grid; grid-template-columns: 1fr 34px; gap: 8px; }
  .ans-feature input { min-height: 39px; }
  .ans-feature button {
    display: grid;
    place-items: center;
    border: 0;
    color: #a56f6a;
    background: transparent;
    cursor: pointer;
    transition: color 180ms ease,transform 180ms ease;
  }
  .ans-feature button:hover { color: #ef9f96; transform: scale(1.12); }
  .ans-feature svg { width: 14px;height: 14px; }

  .ans-media { min-height: 505px; padding: 27px 24px; }
  .ans-media__label { display: block; margin: 5px 0 10px; }
  .ans-media__label.is-gallery { margin-top: 25px; }
  .ans-file-input { position: absolute; width: 1px;height: 1px;overflow: hidden;clip: rect(0 0 0 0); }
  .ans-thumbnail {
    position: relative;
    display: flex;
    min-height: 160px;
    padding: 20px;
    align-items: center;
    justify-content: center;
    flex-direction: column;
    overflow: hidden;
    border: 1px dashed rgba(237,198,79,.27);
    border-radius: 6px;
    color: var(--ans-gold);
    background: repeating-linear-gradient(135deg,rgba(255,255,255,.008) 0 8px,transparent 8px 16px),#0d0e0d;
    cursor: pointer;
    transition: border-color 220ms ease,box-shadow 220ms ease,transform 220ms ease;
  }
  .ans-thumbnail:hover { border-color: rgba(237,198,79,.55);box-shadow: 0 0 24px rgba(237,198,79,.06);transform: translateY(-2px); }
  .ans-thumbnail > svg { width: 27px;height: 27px;margin-bottom: 12px; }
  .ans-thumbnail strong { color: #bcb6ad;font-size: 9px;font-weight: 500; }
  .ans-thumbnail small { margin-top: 4px;color:#77726a;font-size:7px; }
  .ans-thumbnail.is-filled { padding:0;cursor:default; }
  .ans-thumbnail.is-filled img { width:100%;height:160px;object-fit:cover; }
  .ans-thumbnail.is-filled button,
  .ans-gallery__item.is-filled button {
    position:absolute;
    top:8px;
    right:8px;
    display:grid;
    width:28px;
    height:28px;
    place-items:center;
    border:1px solid rgba(255,255,255,.16);
    border-radius:50%;
    color:#f0b0aa;
    background:rgba(11,11,10,.82);
    cursor:pointer;
    backdrop-filter:blur(6px);
  }
  .ans-thumbnail.is-filled button svg,.ans-gallery__item.is-filled button svg { width:13px;height:13px; }
  .ans-gallery { display:grid;grid-template-columns:1fr 1fr;gap:8px; }
  .ans-gallery__item {
    position:relative;
    display:grid;
    min-height:93px;
    place-items:center;
    overflow:hidden;
    border:1px solid rgba(255,255,255,.08);
    border-radius:5px;
    color:#706c65;
    background:#0d0e0d;
    cursor:pointer;
    transition:border-color 180ms ease,color 180ms ease,transform 180ms ease;
  }
  .ans-gallery__item:hover { color:var(--ans-gold);border-color:rgba(237,198,79,.35);transform:translateY(-2px); }
  .ans-gallery__item > svg { width:17px;height:17px; }
  .ans-gallery__item.is-filled { cursor:default; }
  .ans-gallery__item.is-filled img { width:100%;height:93px;object-fit:cover; }
  .ans-media__hint { margin:11px 0 0;color:#65615b;font-size:7px;line-height:1.45; }
  .is-spinning { animation:ans-spin 850ms linear infinite; }

  .ans-publishing { padding:24px; }
  .ans-publishing > strong {
    display:block;
    color:var(--ans-gold);
    font:800 9px ui-monospace,SFMono-Regular,Menlo,monospace;
    letter-spacing:.1em;
    text-transform:uppercase;
  }
  .ans-publishing dl { display:grid;margin:18px 0;gap:14px; }
  .ans-publishing dl div { display:flex;align-items:center;justify-content:space-between;gap:15px; }
  .ans-publishing dt { color:#aaa49a;font-size:8px; }
  .ans-publishing dd { margin:0;color:#d2cdc5;font-size:8px;text-align:right; }
  .ans-publishing button {
    position:relative;
    display:inline-flex;
    width:100%;
    min-height:42px;
    margin-top:10px;
    align-items:center;
    justify-content:center;
    gap:8px;
    overflow:hidden;
    border:1px solid rgba(255,255,255,.1);
    border-radius:5px;
    color:#ddd8d0;
    background:transparent;
    cursor:pointer;
    font-size:9px;
    transition:transform 200ms ease,border-color 200ms ease,box-shadow 200ms ease;
  }
  .ans-publishing button svg { width:13px;height:13px; }
  .ans-publishing button:hover { border-color:rgba(237,198,79,.4);box-shadow:0 0 18px rgba(237,198,79,.05);transform:translateY(-2px); }
  .ans-publishing .ans-publishing__publish { color:#1a1507;border-color:var(--ans-gold);background:linear-gradient(135deg,#f3d184,#deb65e);box-shadow:0 12px 28px rgba(237,198,79,.12); }
  .ans-publishing .ans-publishing__discard { margin-top:19px;color:#906d68;border:0;background:transparent;font-size:7px; }
  .ans-publishing button:disabled,.ans-header__actions button:disabled { opacity:.45;cursor:wait;transform:none; }

  @keyframes ans-reveal { from { opacity:0;transform:translate3d(0,18px,0) scale(.994); } to { opacity:1;transform:none; } }
  @keyframes ans-spin { to { transform:rotate(360deg); } }

  @media (max-width:1080px) {
    .ans-layout { grid-template-columns:1fr; }
    .ans-side-column { position:static;grid-template-columns:1fr 1fr; }
    .ans-media { min-height:0; }
  }

  @media (max-width:720px) {
    .ans-header { min-height:0;align-items:stretch;flex-direction:column; }
    .ans-header__actions { display:grid;grid-template-columns:1fr 1fr; }
    .ans-header__actions button:first-child { grid-column:1 / -1; }
    .ans-two-fields,.ans-side-column { grid-template-columns:1fr; }
    .ans-card { padding:22px 16px; }
    .ans-media { padding:22px 16px; }
  }

  @media (prefers-reduced-motion:reduce) {
    .ans-reveal { opacity:1;transform:none;animation:none; }
    .ans-admin *,.ans-admin *::before,.ans-admin *::after { transition-duration:.01ms !important; }
  }
