{
  "name": "mahreen-website",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:local": "vite --mode localmode",
    "dev:api": "vite --mode api",
    "build": "tsc -b && vite build && node scripts/inline-entry-css.mjs && node scripts/finalize-site-metadata.mjs && node scripts/generate-seo-pages.mjs && node scripts/validate-build.mjs",
    "build:api": "tsc -b && vite build --mode api && node scripts/inline-entry-css.mjs && node scripts/finalize-site-metadata.mjs && node scripts/generate-seo-pages.mjs && node scripts/validate-build.mjs",
    "build:demo": "tsc -b && vite build --mode demo && node scripts/inline-entry-css.mjs && node scripts/finalize-site-metadata.mjs && node scripts/generate-seo-pages.mjs && node scripts/validate-build.mjs",
    "build:local": "npm run build:demo",
    "lint": "eslint .",
    "optimize:images": "node scripts/optimize-images.mjs --apply --prune-unused",
    "optimize:markup": "node scripts/optimize-image-markup.mjs --apply",
    "optimize:responsive": "node scripts/generate-responsive-images.mjs",
    "test:assets": "node scripts/validate-asset-references.mjs",
    "test:local": "node scripts/validate-local-mode.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fontsource-variable/cormorant-garamond": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "lucide-react": "^1.22.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-phone-number-input": "^3.4.17"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "sharp": "^0.35.3",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12"
  },
  "engines": {
    "node": "22.x"
  },
  "packageManager": "npm@10.9.2"
}
