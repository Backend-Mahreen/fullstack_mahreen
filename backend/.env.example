# Port server API.
PORT=3000

# Set true hanya bila aplikasi berjalan di belakang reverse proxy
# (nginx, Vercel, Cloudflare) agar rate limiter membaca IP klien yang benar.
TRUST_PROXY=false

# WAJIB. Tidak ada nilai bawaan: server menolak start bila kosong,
# kurang dari 32 karakter, atau masih memakai nilai contoh.
# Buat secret acak dengan:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Opsional. Secret terpisah untuk refresh token. Bila dikosongkan,
# nilainya diturunkan secara deterministik dari JWT_SECRET.
JWT_REFRESH_SECRET=

# Origin frontend yang diizinkan mengakses API.
# Durasi sesi (opsional - default bila diabaikan).
# ACCESS = masa berlaku access token, REFRESH = masa berlaku refresh token.
# REMEMBER_DAYS = durasi sesi \"Saya ingat perangkat ini\".
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=7d
REFRESH_REMEMBER_DAYS=30
CORS_ORIGIN=http://localhost:5173

# Koneksi MySQL. Jangan pakai user root di produksi:
# buat user khusus dengan hak akses terbatas pada database ini saja.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=
DB_PASS=
DB_NAME=mahreen_indonesia

# Frontend route links untuk default newsroom settings.
# Opsional — hanya perlu di-set jika hash route berubah.
FRONTEND_CTA_PRIMARY_LINK=/tanya-mahreen
FRONTEND_CTA_SECONDARY_LINK=/contact

# Midtrans Payment Gateway.
# Dapatkan key dari https://dashboard.midtrans.com/
# Set MIDTRANS_IS_PRODUCTION=true untuk live.
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false

# Origin frontend untuk callback URL setelah pembayaran.
FRONTEND_ORIGIN=http://localhost:5173
